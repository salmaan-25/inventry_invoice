# SECRET_KEY — generate a unique value for each environment
SECRET_KEY=change-me-to-a-long-random-string

# DEBUG — set to False in production
DEBUG=True

# ALLOWED_HOSTS — comma-separated hostnames; example: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_NAME=billing_inventory
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# CORS — comma-separated origins the frontend runs on (development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Django settings module to use
DJANGO_SETTINGS_MODULE=config.settings.development
